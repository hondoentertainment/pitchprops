# ---- Odds data provider ----
# The app works WITHOUT a key (realistic mock data + demo scores).
# Add a key to pull live soccer odds & player props.

# Provider: "theoddsapi" (default) or "mock"
ODDS_PROVIDER=theoddsapi

# The Odds API key -> https://the-odds-api.com  (free tier available)
ODDS_API_KEY=

# Comma-separated soccer league keys (The Odds API "sport keys").
ODDS_LEAGUES=soccer_epl,soccer_uefa_champs_league,soccer_spain_la_liga,soccer_italy_serie_a

# Odds format / region
ODDS_REGION=eu

# ---- Production (Vercel) ----
# Add the same variables in Vercel → Project → Settings → Environment Variables
# for Production (and Preview if desired), then redeploy.
