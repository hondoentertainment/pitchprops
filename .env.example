# ---- Odds data provider ----
# The app works WITHOUT a key (it serves realistic mock data).
# Add a key to pull live soccer odds & player props.

# Provider: "theoddsapi" (default) or "mock"
ODDS_PROVIDER=theoddsapi

# The Odds API key -> https://the-odds-api.com  (free tier available)
ODDS_API_KEY=

# Comma-separated soccer league keys to load (The Odds API "sport keys").
# Examples: soccer_epl, soccer_uefa_champs_league, soccer_spain_la_liga,
#           soccer_italy_serie_a, soccer_germany_bundesliga, soccer_usa_mls
ODDS_LEAGUES=soccer_epl,soccer_uefa_champs_league,soccer_spain_la_liga,soccer_italy_serie_a

# Odds format / region
ODDS_REGION=eu
